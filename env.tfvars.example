# Authentik URL. Change the port if you set COMPOSE_PORT_HTTP in .env.
server = "http://localhost:9000"

# Brand domain. Also sets the LDAP base DN (example.org -> dc=example,dc=org).
domain = "example.org"

# Entra ID app registration for the InCommon sign-in button (see README).
# Leave these blank to run without it; everything else still works.
oidc_tenant_id     = ""
oidc_client_id     = ""
oidc_client_secret = ""

# Required. Password for the ldapservice account that LDAP clients bind with.
bind_account_password = ""

# Leave blank. `make run` fills this in.
token = ""
