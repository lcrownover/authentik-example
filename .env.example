AUTHENTIK_TAG=2026.2.3

# Password for the akadmin account, applied when the database is first created
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme

# Required. Generate each with: openssl rand -base64 36 | tr -d '\n'
# Don't change them after the first `make run`, or the existing database stops working.
PG_PASS=
AUTHENTIK_SECRET_KEY=

# Outgoing mail, used for the "new user pending approval" email to admins
AUTHENTIK_EMAIL__HOST=smtp.example.org
AUTHENTIK_EMAIL__PORT=25
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=authentik@example.org

# Optional host ports (defaults shown)
# COMPOSE_PORT_HTTP=9000
# COMPOSE_PORT_HTTPS=9443
# COMPOSE_PORT_LDAP=389
# COMPOSE_PORT_LDAPS=636
